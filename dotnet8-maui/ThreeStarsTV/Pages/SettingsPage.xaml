<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ThreeStarsTV.Pages.SettingsPage"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,*" BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#1E1E1E}">
        <!-- 标题栏 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" HeightRequest="48" Padding="6,0"
              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252526}">
            <Button x:Name="BackBtn" Grid.Column="0" Text="←" FontSize="18" Padding="6,0"
                    TextColor="{AppThemeBinding Light=#0078D4, Dark=#91CAFF}"
                    BackgroundColor="Transparent" Clicked="OnBackClicked"/>
            <Label x:Name="TitleLabel" Grid.Column="1" FontSize="13"
                   TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"
                   VerticalOptions="Center" Margin="4,0,0,0"/>
        </Grid>
        <BoxView Grid.Row="1" HeightRequest="1" Color="{AppThemeBinding Light=#D0D0D0, Dark=#3F3F46}"/>

        <!-- 标签页 -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="TabBar" Spacing="0" Padding="6,0"
                                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252526}"/>
            </ScrollView>
            <BoxView Grid.Row="0" HeightRequest="1" VerticalOptions="End"
                     Color="{AppThemeBinding Light=#D0D0D0, Dark=#3F3F46}"/>
            <ContentView x:Name="TabContent" Grid.Row="1"/>
        </Grid>
    </Grid>
</ContentPage>
